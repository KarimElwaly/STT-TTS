# ---------------------------------------------------------------------------
# Runtime profile: gpu | cpu | auto
#   auto -> probes CUDA availability + free VRAM and resolves at startup.
# ---------------------------------------------------------------------------
VOICEGW_PROFILE=auto

# Pin individual engines regardless of profile (optional).
# STT: cohere-asr | cohere-asr-cpu | faster-whisper
# TTS: omnivoice | omnivoice-cpu | piper
# VOICEGW_ASR_ENGINE=
# VOICEGW_TTS_ENGINE=

# Hugging Face token. REQUIRED for the Cohere ASR model: the repo is gated,
# accept the terms at
#   https://huggingface.co/CohereLabs/cohere-transcribe-arabic-07-2026
# with your account first, then create a read token.
HF_TOKEN=

VOICEGW_HOST=127.0.0.1
VOICEGW_PORT=8000
VOICEGW_DEFAULT_LANGUAGE=ar
VOICEGW_VOICES_DIR=voices

# Minimum free VRAM (MiB) for `auto` to pick the gpu profile.
# Cohere ASR bf16 ~4.0 GiB + OmniVoice fp16 ~1.2 GiB.
VOICEGW_MIN_VRAM_MIB=4500

# ---------------------------------------------------------------------------
# GPU residency: shared | exclusive | auto
#   shared    - both models stay in VRAM. Fastest, needs a roomy GPU.
#   exclusive - only the model in use holds VRAM; the other parks in system
#               RAM. Costs a few hundred ms per swap but is the difference
#               between working and thrashing on a 6-8 GB laptop GPU.
#   auto      - exclusive when total VRAM is below the threshold below.
# ---------------------------------------------------------------------------
VOICEGW_RESIDENCY=auto
VOICEGW_SHARED_RESIDENCY_MIN_VRAM_MIB=10000

# OmniVoice diffusion steps: the main TTS latency/quality knob.
# 32 (library default) ~1.4s per 4s utterance; 16 ~0.75s; 8 ~0.4s; 4 ~0.2s.
# Run `python scripts/tune_tts.py`, listen to out/tts_steps/*.wav, then choose.
VOICEGW_TTS_NUM_STEP=16

# ---------------------------------------------------------------------------
# Fully local / offline operation.
#   1. Run `voicegw fetch` once with a network connection to fill the cache.
#   2. Set VOICEGW_OFFLINE=1. Models then load from the local cache only and
#      a missing file fails immediately instead of trying to download.
# Nothing else phones home: the VAD ships inside silero-vad, the web client
# uses no CDN, and the agent below is a local endpoint.
# ---------------------------------------------------------------------------
VOICEGW_OFFLINE=0

# Pin the faster-whisper size (default: large-v3-turbo on GPU, small on CPU).
# Bigger is more accurate and slower; on CPU anything above `small` misses the
# realtime budget. tiny | base | small | medium | large-v3-turbo | large-v3
# VOICEGW_WHISPER_MODEL=

# Agent hook used by the realtime loop. Any OpenAI-compatible chat endpoint.
# The default is a local Ollama server, so the whole stack stays offline.
VOICEGW_AGENT_BASE_URL=http://localhost:11434/v1
VOICEGW_AGENT_MODEL=qwen2.5:7b
VOICEGW_AGENT_API_KEY=not-needed
VOICEGW_AGENT_SYSTEM_PROMPT=أنت مساعد صوتي مفيد. أجب بإيجاز.
